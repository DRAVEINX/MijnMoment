{
  "name": "mijnmoment",
  "version": "0.6.0",
  "private": true,
  "description": "Gratis toegankelijke cliëntenapp MijnMoment",
  "scripts": {
    "test": "node scripts/smoke-test.mjs",
    "check": "node --check app.js && node scripts/smoke-test.mjs",
    "build:web": "mkdir -p dist && cp index.html styles.css app.js manifest.webmanifest sw.js dist/ && cp -r assets dist/assets",
    "android:init": "npx cap add android",
    "android:sync": "npx cap sync android"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@capacitor/android": "^7.4.3"
  }
}
